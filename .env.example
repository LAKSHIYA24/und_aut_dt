# Local MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/autouw
MONGODB_DB=autouw

# Shared secret keys
JWT_SECRET=change-me-jwt-secret-min-32-chars-long!!
SERVICE_SECRET=dev-service-secret
ADMIN_SEED_PASSWORD=ChangeMe!Admin1

# Local database fallback
DATABASE_PATH=./data/autouw.db
UPLOAD_DIR=./data/uploads

# Service URLs
APPLICANT_SERVICE_URL=http://127.0.0.1:4100
UNDERWRITER_SERVICE_URL=http://127.0.0.1:4102
RISK_ENGINE_URL=http://127.0.0.1:5100
